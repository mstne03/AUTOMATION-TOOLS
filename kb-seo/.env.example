# Copia a .env y pon contrasenas reales. .env NUNCA se commitea.

# --- Postgres (solo escucha en 127.0.0.1) ---
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=kb_seo

# Superusuario del contenedor. Solo lo usa docker-compose al inicializar.
POSTGRES_USER=kb_admin
POSTGRES_PASSWORD=cambiame_admin

# Rol de escritura: lo usa la CLI de ingesta.
KB_WRITER_USER=kb_writer
KB_WRITER_PASSWORD=cambiame_writer

# Rol de solo lectura: lo usa el servidor MCP.
KB_READER_USER=kb_reader
KB_READER_PASSWORD=cambiame_reader

# --- Embeddings ---
# fastembed: ONNX en proceso, sin servicios externos (lo que usa el cliente).
# ollama: alternativa para la ingesta; OLLAMA_URL y un modelo en Ollama (bge-m3).
OLLAMA_URL=http://127.0.0.1:11434
EMBED_BACKEND=fastembed
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIM=384

# --- Busqueda ---
# postgres (desarrollo/VPS) o sqlite (snapshot exportado con kb-export).
KB_BACKEND=postgres
#KB_SQLITE_PATH=./kb-public.sqlite
#KB_PRIVATE_SQLITE_PATH=./kb-private.sqlite
