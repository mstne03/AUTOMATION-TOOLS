# Copia este archivo a .env (en la carpeta del servidor) y rellénalo.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
FOOTY_ROOT=C:\Footy
# Opcional: solo si la CLI de HyperFrames no encuentra Chrome.
HYPERFRAMES_BROWSER_PATH=
# 0-1, volumen de la música bajo la voz.
FOOTY_MUSICA_VOLUMEN=0.12
# Opcional: carpeta bin de FFmpeg si no está en el PATH que ve Claude Desktop.
FFMPEG_DIR=
