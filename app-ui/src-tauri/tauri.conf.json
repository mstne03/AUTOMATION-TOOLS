{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SEO Studio",
  "version": "0.1.0",
  "identifier": "com.seostudio.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SEO Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'",
      "devCsp": "default-src 'self' http://localhost:1420; frame-src http://127.0.0.1:*; connect-src ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:1420 ws://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/app-backend"
    ],
    "resources": {
      "binaries/_internal/": "_internal/",
      "binaries/video-engine/": "video-engine/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "zlib"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzRUM0OTdCMDM1QTE1NTEKUldSUkZWb0RlMG5zd3laVmx3UVpJUzNxTy9NQStCYWtYdCsvR3F0UnBZc1JZeHJNRjJ0T2s4MlcK",
      "endpoints": [
        "https://kb.mstne.dev/app/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
