# Copia a .env o .env.local (misma carpeta que pyproject.toml); .env.local pisa a .env.
# Ambos estan en .gitignore: NUNCA se commitean.
# Solo para desarrollo: en el producto la clave de Anthropic va al Credential Manager
# (PUT /settings {"anthropic_api_key": ...}) y el almacen tiene prioridad sobre esta variable.

# Clave de Anthropic (console.anthropic.com -> API Keys). Respaldo si no hay ninguna guardada.
ANTHROPIC_API_KEY=sk-ant-...

# Token fijo para probar con curl. Si falta se genera uno distinto en cada arranque.
APP_BACKEND_TOKEN=

# Directorio de estado (ajustes, quota.json, jobs.sqlite). Por defecto %LOCALAPPDATA%\seo-studio.
APP_BACKEND_DIR=

# keyring (por defecto, Credential Manager) o file (JSON en claro en APP_BACKEND_DIR; solo tests).
APP_BACKEND_SECRETS=keyring
